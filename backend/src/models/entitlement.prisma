enum EntitlementValueType {
  number
  boolean
  string
}

model Entitlement {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(100)
  name        String               @db.VarChar(150)
  description String?              @db.Text
  valueType   EntitlementValueType @map("value_type")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  plans       PlanEntitlement[]

  @@map("entitlements")
}

model PlanEntitlement {
  planId        String      @map("plan_id") @db.Uuid
  entitlementId String      @map("entitlement_id") @db.Uuid
  value         Json        @db.JsonB
  plan          ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)

  @@id([planId, entitlementId])
  @@index([entitlementId])
  @@map("plan_entitlements")
}
