model Candidate {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String    @unique @map("account_id") @db.Uuid
  fullName          String    @map("full_name") @db.VarChar(150)
  phone             String?   @db.VarChar(30)
  avatarKey         String?   @map("avatar_url") @db.VarChar(500)
  headline          String?   @db.VarChar(255)
  careerGoal        String?   @map("career_goal") @db.Text
  experienceYears   Decimal?  @default(0) @map("experience_years") @db.Decimal(4, 1)
  currentLocationId String?   @map("current_location_id") @db.Uuid
  profileCompletion Int?      @default(0) @map("profile_completion") @db.SmallInt
  isSearchable      Boolean?  @default(true) @map("is_searchable")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentLocation Province?    @relation("CandidateLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  cvs           Cv[]
  applications  Application[]
  savedJobs     SavedJob[]
  conversations Conversation[]

  @@index([currentLocationId])
  @@index([isSearchable, deletedAt])

  @@map("candidate")
}
